# Backend local secrets — copy this file to ".env" in the same folder as Vechile Part.csproj
# and fill in real values. ".env" is gitignored.

# PostgreSQL / Supabase (Npgsql connection string)
# Use double quotes if the password has special characters.
ConnectionStrings__DefaultConnection="Host=YOUR_HOST;Database=postgres;Username=postgres;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"
