  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VechilePart.Application\VechilePart.Application.csproj" />
    <ProjectReference Include="..\VechilePart.Infrastructure\VechilePart.Infrastructure.csproj" />
  </ItemGroup>

</Project>
