@Vechile_Part_HostAddress = http://localhost:5019

# Feature 1 — financial reports
GET {{Vechile_Part_HostAddress}}/api/reports/financial?type=Monthly
Accept: application/json

###

# Feature 9 — customer reports (regulars, high spenders, pending credits)
GET {{Vechile_Part_HostAddress}}/api/reports/customers
Accept: application/json

###

# Feature 15 — low stock (default threshold 10)
GET {{Vechile_Part_HostAddress}}/api/reports/low-stock
Accept: application/json

